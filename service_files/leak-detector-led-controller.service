[Unit]
Description=Leak Detector LED controller service
Wants=mapper-wait@-xyz-openbmc_project-led-groups.service
After=mapper-wait@-xyz-openbmc_project-led-groups.service

[Service]
Restart=always
ExecStart=/usr/libexec/phosphor-led-manager/leak-detector-led-controller --config /usr/share/phosphor-led-manager/leak-detector-led-config.json
SyslogIdentifier=leak-detector-led-controller

[Install]
WantedBy=multi-user.target
