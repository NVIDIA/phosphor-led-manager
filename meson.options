option('tests', type: 'feature', value: 'enabled', description: 'Build tests')

option(
    'use-json',
    type: 'feature',
    value: 'enabled',
    description: 'LEDs JSON filepath',
)

option(
    'use-lamp-test',
    type: 'feature',
    value: 'enabled',
    description: 'LEDs lamp test configuration',
)

option(
    'monitor-operational-status',
    type: 'feature',
    value: 'disabled',
    description: 'Enable OperationalStatus monitor',
)

option(
    'monitor-leak-detector',
    type: 'feature',
    value: 'disabled',
    description: 'Enable LeakDetector monitor (drives the leak_critical LED group)',
)

option(
    'gpio-led',
    type: 'feature',
    value: 'disabled',
    description: 'Enable the NVIDIA GPIO LED controller (arbitrated LEDs)',
)

option(
    'persistent-led-asserted',
    type: 'feature',
    value: 'enabled',
    description: 'Persistent the asserted status of ledgroup',
)
